{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "namespace",
    "name",
    "version"
  ],
  "properties": {
    "namespace": {
      "type": "string",
      "description": "The namespace of the event"
    },
    "name": {
      "type": "string",
      "description": "The name of the event"
    },
    "version": {
      "type": "string",
      "description": "The version of the event"
    },
    "correlationToken": {
      "type": "string",
      "description": "Token used for correlating related events"
    },
    "id": {
      "type": "string",
      "description": "An ID to uniquely identify the event. This is used to deduplicate an event.  Each ID is formatted as: port1/systems/zero/messages/123123. \n"
    }
  }
}
