{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "A condition that must hold on the operation context for the rule to apply. A rule applies only when all of its conditions match.",
  "additionalProperties": false,
  "required": [
    "key",
    "comparator",
    "value"
  ],
  "properties": {
    "key": {
      "$ref": "/docs/references/schemas/AccessControlConditionKey.json"
    },
    "comparator": {
      "$ref": "/docs/references/schemas/AccessControlConditionComparator.json"
    },
    "value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "The value the context attribute is compared with.",
      "example": "google-nest-customer-oauth"
    }
  }
}
