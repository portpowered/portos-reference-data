{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "An equalizer frequency band adjustment delta",
  "required": [
    "name",
    "valueDelta"
  ],
  "properties": {
    "name": {
      "type": "string",
      "enum": [
        "BASS",
        "MIDRANGE",
        "TREBLE"
      ]
    },
    "valueDelta": {
      "type": "integer"
    }
  }
}
