{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-namespace": "port1/systems/zero/capability-interfaces/flows",
  "x-name": "node-complete",
  "x-version": "1.0",
  "x-type": "message",
  "x-directionality": "out",
  "type": "object",
  "properties": {
    "flowId": {
      "type": "string",
      "description": "Unique identifier for the flow",
      "minLength": 1
    },
    "nodeId": {
      "type": "string",
      "description": "Unique identifier for the completed node",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "description": "Node completion status",
      "enum": [
        "SUCCESS",
        "FAILURE",
        "SKIPPED",
        "TIMEOUT"
      ],
      "x-enum-varnames": [
        "FlowsInterfaceNodeCompleteMessageStatusSuccess",
        "FlowsInterfaceNodeCompleteMessageStatusFailure",
        "FlowsInterfaceNodeCompleteMessageStatusSkipped",
        "FlowsInterfaceNodeCompleteMessageStatusTimeout"
      ]
    },
    "result": {
      "type": "object",
      "description": "Node execution result",
      "additionalProperties": true
    },
    "duration": {
      "type": "number",
      "description": "Node execution duration in milliseconds",
      "minimum": 0
    },
    "nextNodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of next node IDs to execute"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata for the node completion",
      "additionalProperties": true
    }
  },
  "required": [
    "flowId",
    "nodeId",
    "status",
    "duration"
  ],
  "additionalProperties": false
}
