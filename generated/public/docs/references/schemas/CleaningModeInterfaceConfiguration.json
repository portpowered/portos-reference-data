{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-namespace": "port1/systems/zero/capability-interfaces/cleaning-mode",
  "x-name": "cleaning-mode",
  "x-version": "1.0",
  "x-type": "configuration",
  "description": "Cleaning types, suction levels and water flows the robot supports, refreshed on every discovery. set-cleaning-mode values outside these lists are rejected before dispatch.",
  "type": "object",
  "required": [
    "supportedModes"
  ],
  "properties": {
    "supportedModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "/docs/references/schemas/CleaningType.json"
      },
      "description": "Supported cleaning types"
    },
    "supportedSuctionLevels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "/docs/references/schemas/SuctionLevel.json"
      },
      "description": "Supported suction levels"
    },
    "supportedWaterFlows": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "/docs/references/schemas/WaterFlow.json"
      },
      "description": "Supported water flows"
    }
  },
  "additionalProperties": false
}
