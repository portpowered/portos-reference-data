{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-namespace": "port1/systems/zero/capability-interfaces/flows",
  "x-name": "pause",
  "x-version": "1.0",
  "x-type": "message",
  "x-directionality": "in",
  "type": "object",
  "properties": {
    "flowId": {
      "type": "string",
      "description": "Unique identifier for the flow to pause",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "description": "Reason for pausing",
      "enum": [
        "USER_REQUEST",
        "RESOURCE_LIMIT",
        "WAITING",
        "MAINTENANCE"
      ],
      "x-enum-varnames": [
        "FlowsInterfacePauseMessageReasonUserRequest",
        "FlowsInterfacePauseMessageReasonResourceLimit",
        "FlowsInterfacePauseMessageReasonWaiting",
        "FlowsInterfacePauseMessageReasonMaintenance"
      ]
    },
    "checkpoint": {
      "type": "boolean",
      "description": "Whether to create a checkpoint before pausing",
      "default": true
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata for the pause operation",
      "additionalProperties": true
    }
  },
  "required": [
    "flowId",
    "reason"
  ],
  "additionalProperties": false
}
