{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "string",
  "enum": [
    "NOT_FOUND",
    "BAD_REQUEST",
    "UNAUTHORIZED",
    "FORBIDDEN",
    "CONFLICT",
    "GONE",
    "PRECONDITION_FAILED",
    "PRECONDITION_REQUIRED",
    "PAYLOAD_TOO_LARGE",
    "UNSUPPORTED_MEDIA_TYPE",
    "UNPROCESSABLE_ENTITY",
    "LOCKED",
    "TOO_MANY_REQUESTS",
    "BAD_GATEWAY",
    "SERVICE_UNAVAILABLE",
    "GATEWAY_TIMEOUT",
    "NOT_IMPLEMENTED",
    "INTERNAL_SERVER_ERROR",
    "REQUEST_INVALID",
    "AUTHENTICATION",
    "PERMISSION",
    "ENDPOINT_NOT_FOUND",
    "ENDPOINT_STATE_CONFLICT",
    "ENDPOINT_UNAVAILABLE",
    "RATE_LIMIT",
    "PROVIDER_BAD_RESPONSE",
    "PROVIDER_UNAVAILABLE",
    "PROVIDER_TIMEOUT"
  ],
  "description": "The broad class of an error. The family decides the HTTP status of a REST error, so clients can handle every code of a family alike."
}
