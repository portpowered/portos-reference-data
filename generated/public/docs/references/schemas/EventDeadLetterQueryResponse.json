{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "$ref": "/docs/references/schemas/EventDeadLetter.json"
      }
    },
    "paginationContext": {
      "$ref": "/docs/references/schemas/PaginationContext.json"
    },
    "errors": {
      "type": "array",
      "description": "Partial query errors; omitted when no errors occurred.",
      "items": {
        "$ref": "/docs/references/schemas/Error.json"
      }
    }
  },
  "description": "Authorized redacted dead-letter results with opaque cursor pagination and partial query errors."
}
