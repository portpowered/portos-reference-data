{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Creates or updates an endpoint simulator.",
  "allOf": [
    {
      "$ref": "/docs/references/schemas/SimulatorSharedFields.json"
    },
    {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "/docs/references/schemas/TypeValue.json"
        },
        "id": {
          "type": "string",
          "description": "The unique identifier for the simulator (optional; if provided, performs an update/upsert)",
          "pattern": "^port1\\.simulator\\..*"
        }
      }
    }
  ]
}
