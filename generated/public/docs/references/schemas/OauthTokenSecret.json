{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "/docs/references/schemas/BaseSecret.json"
    },
    {
      "type": "object",
      "required": [
        "accessToken",
        "refreshToken",
        "expiresIn",
        "scopes"
      ],
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "The OAuth access token"
        },
        "refreshToken": {
          "type": "string",
          "description": "The OAuth refresh token"
        },
        "pluginCustomMetadata": {
          "type": "object",
          "additionalProperties": true,
          "description": "A set of custom metadata that the plugin uses and attaches to the token, this is meant specifically for the plugin to use."
        },
        "expiresIn": {
          "type": "integer",
          "description": "The token expiration time in seconds"
        },
        "scopes": {
          "type": "string",
          "description": "The OAuth scopes"
        }
      }
    }
  ]
}
