{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "A supported input source",
  "properties": {
    "name": {
      "type": "string"
    },
    "index": {
      "type": "integer",
      "description": "Input index",
      "minimum": 0
    },
    "inputType": {
      "type": "string",
      "description": "Type of input connector",
      "enum": [
        "HDMI",
        "COMPOSITE",
        "COMPONENT",
        "SVIDEO",
        "VGA",
        "DVI",
        "USB",
        "BLUETOOTH",
        "WIFI",
        "ETHERNET",
        "OTHER"
      ]
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false
}
