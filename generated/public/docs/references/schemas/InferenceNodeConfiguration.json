{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-namespace": "port1/systems/zero/flow-nodes/inference",
  "x-version": "1.0",
  "x-type": "configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model": {
      "type": "string",
      "description": "The AI model to use for inference",
      "default": "default"
    },
    "temperature": {
      "type": "number",
      "description": "Sampling temperature (0.0 to 2.0)",
      "minimum": 0,
      "maximum": 2,
      "default": 1
    },
    "maxTokens": {
      "type": "integer",
      "description": "Maximum number of tokens to generate",
      "minimum": 1,
      "maximum": 4096,
      "default": 256
    }
  }
}
