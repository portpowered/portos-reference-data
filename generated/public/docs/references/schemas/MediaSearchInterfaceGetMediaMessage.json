{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-namespace": "port1/systems/zero/capability-interfaces/media-search",
  "x-name": "get-media",
  "x-version": "1.0",
  "x-type": "message",
  "x-directionality": "in",
  "description": "Inspect an exact media resource or traverse an album/show. Use get-playlist for playlist contents.",
  "type": "object",
  "properties": {
    "mediaId": {
      "$ref": "/docs/references/schemas/MediaId.json"
    },
    "maxResults": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 20
    },
    "nextToken": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque continuation for the same resource."
    }
  },
  "required": [
    "mediaId"
  ],
  "additionalProperties": false
}
