{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "The unique identifier for the secret"
    },
    "type": {
      "type": "string",
      "description": "The secret type"
    },
    "ownerId": {
      "type": "string",
      "description": "The owner ID of the secret"
    },
    "owner": {
      "$ref": "/docs/references/schemas/Principal.json"
    }
  }
}
