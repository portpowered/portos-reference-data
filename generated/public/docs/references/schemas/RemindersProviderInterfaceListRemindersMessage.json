{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RemindersProviderInterfaceListRemindersMessage",
  "x-namespace": "port1/systems/zero/capability-interfaces/reminders-provider",
  "x-name": "list-reminders",
  "x-version": "1.0",
  "x-type": "message",
  "x-directionality": "in",
  "description": "List reminder lists and their reminders. Omit listId to enumerate all lists.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "listId": {
      "type": "string",
      "minLength": 1,
      "description": "List identifier from a previous listing."
    },
    "includeCompleted": {
      "type": "boolean",
      "default": false
    },
    "cursor": {
      "type": "string",
      "description": "Opaque next-page cursor."
    },
    "maxResults": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    }
  }
}
