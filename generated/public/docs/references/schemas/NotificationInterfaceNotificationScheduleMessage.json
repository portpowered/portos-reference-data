    "notification": {
      "$ref": "/docs/references/schemas/NotificationPayload.json"
    },
    "schedule": {
      "$ref": "/docs/references/schemas/NotificationSchedule.json"
    },
    "enabled": {
      "type": "boolean",
      "description": "Whether the schedule is enabled",
      "default": true
    }
  },
  "required": [
    "scheduleId",
    "notification",
    "schedule"
  ],
  "additionalProperties": false
