    "BAD_REQUEST",
    "UNAUTHORIZED",
    "FORBIDDEN",
    "INSUFFICIENT_SCOPE",
    "NOT_FOUND",
    "CONFLICT",
    "UNPROCESSABLE_ENTITY",
