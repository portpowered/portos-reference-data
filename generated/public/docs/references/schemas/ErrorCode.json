    "TOO_MANY_REQUESTS",
    "SERVICE_UNAVAILABLE",
    "NOT_IMPLEMENTED",
    "INTERNAL",
    "CHECKSUM_MISMATCH",
    "FILE_TOO_LARGE",
    "STORAGE_UNAVAILABLE",
    "INSUFFICIENT_PERMISSIONS",
    "INVALID_FILE_TYPE",
    "QUOTA_EXCEEDED",
    "CONCURRENT_MODIFICATION",
    "ENDPOINT_UNREACHABLE",
    "BRIDGE_UNREACHABLE",
    "CLOUD_CONTROL_DISABLED",
    "ENDPOINT_BUSY",
    "ENDPOINT_LOW_POWER",
    "AUTHORIZATION_CREDENTIAL_INVALID",
    "AUTHORIZATION_CREDENTIAL_EXPIRED",
    "INVALID_DIRECTIVE",
    "INVALID_VALUE",
    "VALUE_OUT_OF_RANGE",
    "NOT_SUPPORTED_IN_CURRENT_MODE",
    "RATE_LIMIT_EXCEEDED",
    "PROVIDER_SERVICE_UNAVAILABLE",
    "PROVIDER_TIMEOUT",
    "PROVIDER_INTERNAL_ERROR",
    "INVALID_PROVIDER_RESPONSE",
    "OUTCOME_UNKNOWN",
    "PRECONDITION_FAILED",
    "PRECONDITION_REQUIRED",
    "IDEMPOTENCY_KEY_REQUIRED",
    "IDEMPOTENCY_KEY_REUSED",
    "IDEMPOTENCY_KEY_IN_FLIGHT",
    "IDEMPOTENCY_KEY_INVALID",
    "GROUP_MERGED",
    "MULTI_ROOM_UNSUPPORTED",
    "MAP_NOT_ACTIVE",
    "TARGET_UNSUPPORTED",
    "TARGET_AMBIGUOUS",
    "TARGET_GROUP_NOT_FOUND",
    "TARGET_GROUP_DISABLED",
    "DUPLICATE_TARGET_GROUP",
    "MESSAGE_UNSUPPORTED",
    "MESSAGE_AMBIGUOUS",
    "ENDPOINT_DISABLED",
    "ENDPOINT_ROUTE_CHANGED",
    "ENDPOINT_HAS_DEPENDENCIES",
