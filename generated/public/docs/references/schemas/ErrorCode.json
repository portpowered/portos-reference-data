    "EVENT_REDRIVE_CONFLICT",
    "EVENT_REDRIVE_EXPIRED",
    "RECEIPT_CONTEXT_EXPIRED",
    "EVENT_MAINTENANCE_INCOMPLETE",
    "UNKNOWN_INTERFACE",
    "INVALID_CONFIGURATION",
    "INVALID_ATTRIBUTE",
    "PLUGIN_ROUTE_ID_CONFLICT",
    "UNRESOLVED_REFERENCE",
    "INVALID_RELATIONSHIP",
