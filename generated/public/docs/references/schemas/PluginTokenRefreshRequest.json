{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Credentials supplied to a plugin for a token refresh.",
  "additionalProperties": false,
  "required": [
    "authLinkId",
    "refreshToken",
    "accessToken",
    "scopes"
  ],
  "properties": {
    "authLinkId": {
      "type": "string"
    },
    "refreshToken": {
      "type": "string"
    },
    "accessToken": {
      "type": "string"
    },
    "customMetadata": {
      "type": "object",
      "additionalProperties": true,
      "x-go-type-skip-optional-pointer": true
    },
    "scopes": {
      "type": "string"
    }
  }
}
