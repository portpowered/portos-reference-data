{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "A reusable customer OAuth client, without its secret.",
  "required": [
    "id",
    "type",
    "clientId",
    "updatedAt",
    "etag"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "The secret ID of the client credential."
    },
    "type": {
      "type": "string",
      "description": "The secret type."
    },
    "clientId": {
      "type": "string",
      "description": "The OAuth client ID."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "etag": {
      "type": "string",
      "description": "The quoted strong entity tag of the credential."
    }
  }
}
