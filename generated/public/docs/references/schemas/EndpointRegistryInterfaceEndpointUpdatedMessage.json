{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-namespace": "port1/systems/zero/capability-interfaces/endpoint-registry",
  "x-name": "endpoint-updated",
  "x-version": "1.0",
  "x-type": "message",
  "x-directionality": "out",
  "description": "Port OS emitted a durable endpoint metadata or enablement change. Delivery is best effort.",
  "type": "object",
  "properties": {
    "endpointId": {
      "type": "string",
      "description": "Full Port OS endpoint identifier."
    },
    "name": {
      "type": "string",
      "description": "Current endpoint name."
    },
    "type": {
      "type": "string",
      "description": "Current ontological endpoint type."
    },
    "enablement": {
      "type": "string",
      "enum": [
        "ENABLED",
        "DISABLED"
      ],
      "description": "Whether Port OS permits messages to be sent to this endpoint."
    }
  },
  "required": [
    "endpointId",
    "name",
    "type",
    "enablement"
  ],
  "additionalProperties": false
}
