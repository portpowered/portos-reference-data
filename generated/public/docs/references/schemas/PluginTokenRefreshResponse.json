{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Credentials returned by a plugin refresh operation.",
  "additionalProperties": false,
  "required": [
    "accessToken",
    "refreshToken",
    "expiresIn",
    "scopes"
  ],
  "properties": {
    "accessToken": {
      "type": "string"
    },
    "refreshToken": {
      "type": "string"
    },
    "expiresIn": {
      "type": "integer",
      "format": "int64",
      "description": "Seconds until the access token expires."
    },
    "scopes": {
      "type": "string"
    },
    "customMetadata": {
      "type": "object",
      "additionalProperties": true,
      "x-go-type-skip-optional-pointer": true
    }
  }
}
