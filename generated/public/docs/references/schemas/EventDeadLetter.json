{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "description": "Tenant/operator-authorized redacted diagnostics. Does not expose raw payload, callback URL or credentials. Unresolved provider records belong only to provider operators.",
  "required": [
    "id",
    "stage",
    "reasonCode",
    "createdAt",
    "expiresAt",
    "redriveCount",
    "redriveEligible",
    "observedAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "receiptId": {
      "type": [
        "string",
        "null"
      ]
    },
    "eventId": {
      "type": [
        "string",
        "null"
      ]
    },
    "subscriptionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "INGRESS",
        "PROCESSING",
        "DELIVERY",
        "MANAGEMENT"
      ],
      "x-enum-varnames": [
        "EventDeadLetterStageIngress",
        "EventDeadLetterStageProcessing",
        "EventDeadLetterStageDelivery",
        "EventDeadLetterStageManagement"
      ]
    },
    "reasonCode": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "redriveCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "redriveEligible": {
      "type": "boolean"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
