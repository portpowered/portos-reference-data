{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "x-go-type": "map[string]interface{}",
  "properties": {
    "sdp": {
      "type": "string",
      "description": "The SDP answer session contents"
    },
    "streamToken": {
      "type": "string",
      "description": "Provider token for the established stream"
    },
    "streamExtensionToken": {
      "type": "string",
      "description": "Provider token used to extend the established stream"
    },
    "expiresAt": {
      "type": "string",
      "description": "Provider-reported stream expiration"
    },
    "streamUrl": {
      "type": "string",
      "description": "Provider stream URL when the answer is not SDP"
    }
  },
  "additionalProperties": false,
  "description": "The content of the answer"
}
