{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Notification payload information",
  "properties": {
    "title": {
      "type": "string",
      "description": "Notification title",
      "minLength": 1,
      "maxLength": 200
    },
    "body": {
      "type": "string",
      "description": "Notification body text",
      "minLength": 1,
      "maxLength": 2000
    },
    "priority": {
      "type": "string",
      "description": "Notification priority level",
      "enum": [
        "LOW",
        "NORMAL",
        "HIGH",
        "URGENT"
      ],
      "x-enum-varnames": [
        "NotificationPayloadPriorityLow",
        "NotificationPayloadPriorityNormal",
        "NotificationPayloadPriorityHigh",
        "NotificationPayloadPriorityUrgent"
      ]
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "PUSH",
          "EMAIL",
          "SMS",
          "IN_APP",
          "WEBHOOK"
        ],
        "x-enum-varnames": [
          "NotificationPayloadChannelsPush",
          "NotificationPayloadChannelsEmail",
          "NotificationPayloadChannelsSms",
          "NotificationPayloadChannelsInApp",
          "NotificationPayloadChannelsWebhook"
        ]
      },
      "description": "Channels to send the notification through"
    },
    "targetUsers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of user IDs to send the notification to"
    }
  },
  "required": [
    "title",
    "body",
    "priority",
    "channels",
    "targetUsers"
  ],
  "additionalProperties": false
}
