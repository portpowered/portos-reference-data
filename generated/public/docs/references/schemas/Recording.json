{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "A stored recording.",
  "properties": {
    "recordingId": {
      "type": "string",
      "minLength": 1,
      "description": "Provider identifier of the recording."
    },
    "mediaId": {
      "$ref": "/docs/references/schemas/MediaId.json"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Recording start time."
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0,
      "description": "Recording duration in seconds."
    }
  },
  "required": [
    "recordingId"
  ],
  "additionalProperties": false
}
