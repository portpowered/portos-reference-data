{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "A provider region and its endpoints.",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "endpoints": {
      "type": "object",
      "properties": {
        "apiUrl": {
          "type": "string"
        },
        "authorizeUrl": {
          "type": "string"
        },
        "tokenUrl": {
          "type": "string"
        }
      }
    }
  }
}
