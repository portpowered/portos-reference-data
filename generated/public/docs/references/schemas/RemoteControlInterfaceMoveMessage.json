{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-namespace": "port1/systems/zero/capability-interfaces/remote-control",
  "x-name": "move",
  "x-version": "1.0",
  "x-type": "message",
  "x-directionality": "in",
  "type": "object",
  "properties": {
    "velocity": {
