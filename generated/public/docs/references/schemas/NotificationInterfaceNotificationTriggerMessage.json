{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-namespace": "port1/systems/zero/capability-interfaces/notification",
  "x-name": "notification-trigger",
  "x-version": "1.0",
  "x-type": "message",
  "x-directionality": "in",
  "type": "object",
  "properties": {
    "triggerId": {
      "type": "string",
      "description": "Unique identifier for this trigger",
      "minLength": 1
    },
    "triggerType": {
      "type": "string",
      "description": "Type of trigger",
      "enum": [
        "IMMEDIATE",
        "SCHEDULED",
        "EVENT_BASED",
        "CONDITION_BASED"
      ],
      "x-enum-varnames": [
        "Immediate",
        "Scheduled",
        "EventBased",
        "ConditionBased"
      ]
    },
    "notification": {
      "$ref": "/docs/references/schemas/NotificationPayload.json"
    },
    "conditions": {
      "$ref": "/docs/references/schemas/NotificationConditions.json"
    },
    "schedule": {
      "$ref": "/docs/references/schemas/NotificationSchedule.json"
    }
  },
  "required": [
    "triggerId",
    "triggerType",
    "notification"
  ],
  "additionalProperties": false
}
