{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "/docs/references/schemas/BaseSecret.json"
    },
    {
      "type": "object",
      "required": [
        "secretPluginId"
      ],
      "properties": {
        "secretPluginId": {
          "type": "string",
          "description": "The ID of the plugin that the secret is associated with, all custom secrets must be associated with a plugin."
        }
      },
      "additionalProperties": true
    }
  ]
}
