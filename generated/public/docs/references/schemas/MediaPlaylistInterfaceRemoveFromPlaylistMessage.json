{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-namespace": "port1/systems/zero/capability-interfaces/media-playlist",
  "x-name": "remove-from-playlist",
  "x-version": "1.0",
  "x-type": "message",
  "x-directionality": "in",
  "type": "object",
  "properties": {
    "playlistId": {
      "type": "string",
      "description": "ID of the playlist to remove a track from",
      "minLength": 1
    },
    "trackIndex": {
      "type": "integer",
      "description": "Index of the track to remove (-1 to use trackUri instead)"
    },
    "trackUri": {
      "type": "string",
      "description": "URI of the track to remove (used when trackIndex is -1)"
    }
  },
  "required": [
    "playlistId",
    "trackIndex"
  ],
  "additionalProperties": false
}
