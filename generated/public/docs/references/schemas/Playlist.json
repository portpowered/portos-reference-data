{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the playlist",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "description": "Playlist name",
      "minLength": 1
    },
    "ownerId": {
      "type": "string",
      "description": "Provider-scoped owner identity, when supplied by the provider."
    },
    "ownerName": {
      "type": "string",
      "description": "Owner display name, useful for distinguishing owned and followed playlists."
    }
  },
  "required": [
    "id",
    "name"
  ],
  "additionalProperties": false
}
