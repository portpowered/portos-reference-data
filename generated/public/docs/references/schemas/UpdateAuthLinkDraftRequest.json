{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Update a draft auth link. Omitted fields are unchanged.",
  "additionalProperties": false,
  "properties": {
    "regionalizationId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "maxLength": 63,
      "description": "The plugin regionalization the link targets."
    },
    "providerConfiguration": {
      "$ref": "/docs/references/schemas/AuthLinkProviderConfiguration.json"
    },
    "oauthClient": {
      "description": "The customer OAuth client, either an existing secret or new client credentials.",
      "oneOf": [
        {
          "type": "object",
          "title": "ExistingOAuthClient",
          "additionalProperties": false,
          "required": [
            "secretId"
          ],
          "properties": {
            "secretId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "An existing OAuth client secret owned by the caller."
            }
          }
        },
        {
          "type": "object",
          "title": "NewOAuthClient",
          "additionalProperties": false,
          "required": [
            "clientId",
            "clientSecret"
          ],
          "properties": {
            "clientId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "clientSecret": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "writeOnly": true
            }
          }
        }
      ]
    }
  }
}
