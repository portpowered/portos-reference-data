        "DOWN",
        "LEFT",
        "RIGHT",
        "SELECT",
        "BACK",
        "EXIT",
        "MENU",
        "INFO",
        "RED",
        "GREEN",
        "YELLOW",
        "BLUE",
        "CHANNEL_UP",
        "CHANNEL_DOWN",
        "VOLUME_UP",
        "VOLUME_DOWN",
        "MUTE",
        "PLAY",
        "PAUSE",
        "STOP",
        "FAST_FORWARD",
        "REWIND",
        "SKIP_FORWARD",
        "SKIP_BACKWARD",
        "RECORD",
        "RECORD_STOP",
        "POWER",
        "SLEEP",
