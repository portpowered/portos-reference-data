{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "GeoJSON-like multi-polygon: a list of polygons, each a list of rings",
  "required": [
    "type",
    "coordinates"
  ],
  "properties": {
    "type": {
      "type": "string",
      "x-enum-exempt": "GeoJSON geometry type (RFC 7946)",
      "enum": [
        "MultiPolygon"
      ]
    },
    "coordinates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "/docs/references/schemas/SpatialLinearRing.json"
        }
      }
    }
  },
  "additionalProperties": false
}
