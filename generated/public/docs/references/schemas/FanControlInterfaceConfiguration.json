{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-namespace": "port1/systems/zero/capability-interfaces/fan-control",
  "x-name": "fan-control",
  "x-version": "1.0",
  "x-type": "configuration",
  "type": "object",
  "properties": {
    "supportedFanModes": {
      "type": "array",
      "items": {
