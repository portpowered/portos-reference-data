{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Track information",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the track",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "description": "Track name",
      "minLength": 1
    },
    "artists": {
      "type": "array",
      "items": {
        "$ref": "/docs/references/schemas/Artist.json"
      },
      "description": "Track artists"
    },
    "album": {
      "description": "Track album when supplied by the provider. Omitted for sources such as YouTube videos that do not supply album metadata.",
      "allOf": [
        {
          "$ref": "/docs/references/schemas/Album.json"
        }
      ]
    }
  },
  "required": [
    "id",
    "name",
    "artists"
  ],
  "additionalProperties": false
}
