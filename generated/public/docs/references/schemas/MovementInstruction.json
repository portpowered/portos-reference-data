{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "A movement instruction for remote control",
  "properties": {
    "velocity": {
      "type": "number",
      "description": "Forward/backward speed"
    },
    "omega": {
      "type": "number",
      "description": "Angular velocity for turning"
    },
    "duration": {
      "type": "integer",
      "description": "Duration in milliseconds"
    }
  },
  "required": [
    "velocity",
    "omega",
    "duration"
  ],
  "additionalProperties": false
}
