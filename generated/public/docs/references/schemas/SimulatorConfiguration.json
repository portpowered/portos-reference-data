{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "description": "Typed simulator producer settings. Omitted camera profile advertises motion/person; doorbell adds chime. Profile must be compatible with device_type.",
  "required": [],
  "properties": {
    "eventProfile": {
      "type": "string",
      "enum": [
        "CAMERA",
        "DOORBELL",
        "THERMOSTAT"
      ],
      "x-enum-varnames": [
        "SimulatorEventProfileCamera",
        "SimulatorEventProfileDoorbell",
        "SimulatorEventProfileThermostat"
      ]
    }
  }
}
