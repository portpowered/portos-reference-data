{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "A measurement value with optional null support",
  "properties": {
    "value": {
      "type": "number",
      "description": "The measured value"
    },
    "isNull": {
      "type": "boolean",
      "description": "True if the measurement is invalid/null",
      "default": false
    }
  },
  "required": [
    "value",
    "isNull"
  ],
  "additionalProperties": false
}
