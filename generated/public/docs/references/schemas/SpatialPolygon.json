{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "GeoJSON-like polygon: an exterior ring followed by optional interior rings (holes)",
  "required": [
    "type",
    "coordinates"
  ],
  "properties": {
    "type": {
      "type": "string",
      "x-enum-exempt": "GeoJSON geometry type (RFC 7946)",
      "enum": [
        "Polygon"
      ]
    },
    "coordinates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "/docs/references/schemas/SpatialLinearRing.json"
      }
    }
  },
  "additionalProperties": false
}
