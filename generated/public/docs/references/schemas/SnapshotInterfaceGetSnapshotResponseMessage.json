{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-namespace": "port1/systems/zero/capability-interfaces/snapshot",
  "x-name": "get-snapshot-response",
  "x-version": "1.0",
  "x-type": "message",
  "x-directionality": "out",
  "description": "A camera still image, as a short-lived URL or inline base64 according to the request's responseFormat, with the time it was captured",
  "type": "object",
  "required": [
    "image",
    "timeOfSample"
  ],
  "properties": {
    "image": {
      "$ref": "/docs/references/schemas/MediaContent.json"
    },
    "timeOfSample": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
