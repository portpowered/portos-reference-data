{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "/docs/references/schemas/BaseSecret.json"
    },
    {
      "type": "object",
      "required": [
        "keyId"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "description": "The Apple Push Notification key ID"
        },
        "authKey": {
          "type": "string",
          "format": "binary",
          "description": "The Apple Push Notification private key (P8 file)"
        }
      }
    }
  ]
}
