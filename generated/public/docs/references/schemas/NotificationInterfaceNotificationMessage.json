{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-namespace": "port1/systems/zero/capability-interfaces/notification",
  "x-name": "notification",
  "x-version": "1.0",
  "x-type": "message",
  "x-directionality": "out",
  "type": "object",
  "properties": {
    "notificationId": {
      "type": "string",
      "description": "Unique identifier for this notification",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "description": "Notification title",
      "minLength": 1,
      "maxLength": 200
    },
    "body": {
      "type": "string",
      "description": "Notification body text",
      "minLength": 1,
      "maxLength": 2000
    },
    "priority": {
      "type": "string",
      "description": "Notification priority level",
      "enum": [
        "LOW",
        "NORMAL",
        "HIGH",
        "URGENT"
      ],
      "x-enum-varnames": [
        "NotificationInterfaceNotificationMessagePriorityLow",
        "NotificationInterfaceNotificationMessagePriorityNormal",
        "NotificationInterfaceNotificationMessagePriorityHigh",
        "NotificationInterfaceNotificationMessagePriorityUrgent"
      ]
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "PUSH",
          "EMAIL",
          "SMS",
          "IN_APP",
          "WEBHOOK"
        ],
        "x-enum-varnames": [
          "NotificationInterfaceNotificationMessageChannelsPush",
          "NotificationInterfaceNotificationMessageChannelsEmail",
          "NotificationInterfaceNotificationMessageChannelsSms",
          "NotificationInterfaceNotificationMessageChannelsInApp",
          "NotificationInterfaceNotificationMessageChannelsWebhook"
        ]
      },
      "description": "Channels to send the notification through"
    },
    "targetUsers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of user IDs to send the notification to"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata for the notification",
      "additionalProperties": true
    }
  },
  "required": [
    "title",
    "body"
  ],
  "additionalProperties": false
}
