{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FilesystemProviderInterfaceUploadFileMessage",
  "x-namespace": "port1/systems/zero/capability-interfaces/filesystem-provider",
  "x-name": "upload-file",
  "x-version": "1.0",
  "x-type": "message",
  "x-directionality": "in",
  "description": "Upload file.",
  "type": "object",
  "properties": {
    "folderId": {
      "type": "string",
      "minLength": 1,
      "description": "Destination folder identifier."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "File name."
    },
    "mimeType": {
      "type": "string",
      "minLength": 1,
      "description": "File MIME type."
    },
    "data": {
      "type": "string",
      "example": "dGVzdA==",
      "format": "byte",
      "maxLength": 13981016,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "description": "Base64 encoded file content, at most 10 MiB decoded."
    }
  },
  "required": [
    "folderId",
    "name",
    "mimeType",
    "data"
  ],
  "additionalProperties": false
}
