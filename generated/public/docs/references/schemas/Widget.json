{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "The unique identifier for the widget within the context of the view.",
      "example": "port1/systems/zero/widgets/<some-uuid-here>"
    },
    "type": {
      "type": "string",
      "description": "The type of the widget.",
      "example": "port1/systems/zero/widget-types/<some-uuid-here>"
    },
    "configuration": {
      "type": "object",
      "description": "Optional configuration for the widget",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
