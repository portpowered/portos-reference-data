{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "title",
    "positions",
    "widgets"
  ],
  "properties": {
    "title": {
      "$ref": "/docs/references/schemas/TypeValue.json",
      "description": "The title of the view"
    },
    "schemaVersion": {
      "$ref": "/docs/references/schemas/ViewSchemaVersion.json"
    },
    "widgets": {
      "type": "array",
      "items": {
        "$ref": "/docs/references/schemas/Widget.json"
      },
      "description": "The list of widgets in the view"
    },
    "positions": {
      "type": "array",
      "description": "Optional array of position objects for widgets",
      "items": {
        "$ref": "/docs/references/schemas/Position.json"
      }
    }
  },
  "additionalProperties": false
}
