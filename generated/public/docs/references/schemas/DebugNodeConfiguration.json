{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-namespace": "port1/systems/zero/flow-nodes/debug",
  "x-version": "1.0",
  "x-type": "configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "logLevel": {
      "type": "string",
      "description": "Debug logging level",
      "enum": [
        "DEBUG",
        "INFO",
        "WARN",
        "ERROR"
      ],
      "default": "INFO",
      "x-enum-varnames": [
        "DebugFlowNodeConfigurationLogLevel",
        "InfoFlowNodeConfigurationLogLevel",
        "WarnFlowNodeConfigurationLogLevel",
        "ErrorFlowNodeConfigurationLogLevel"
      ]
    },
    "enableMetrics": {
      "type": "boolean",
      "description": "Whether to enable debug metrics collection",
      "default": false
    },
    "outputFormat": {
      "type": "string",
      "description": "Debug output format",
      "enum": [
        "JSON",
        "TEXT",
        "PRETTY"
      ],
      "x-enum-varnames": [
        "Json",
        "Text",
        "Pretty"
      ],
      "default": "JSON"
    }
  }
}
