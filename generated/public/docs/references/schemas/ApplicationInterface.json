{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the interface"
    },
    "version": {
      "type": "string",
      "description": "The version of the interface"
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "/docs/references/schemas/ApplicationInterfaceMessage.json"
      },
      "description": "List of messages supported by the interface"
    },
    "attributes": {
      "type": "array",
      "items": {
        "$ref": "/docs/references/schemas/ApplicationInterfaceAttribute.json"
      },
      "description": "List of attributes supported by the interface"
    },
    "configuration": {
      "type": "object",
      "additionalProperties": true,
      "description": "Interface-specific configuration published for discovery and enumeration."
    }
  }
}
