{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "pluginId"
  ],
  "properties": {
    "authLinkId": {
      "type": "string",
      "description": "Identifier for the auth link"
    },
    "pluginId": {
      "type": "string",
      "description": "The plugin to associate with this auth link"
    },
    "applePushNotificationDeviceToken": {
      "type": "string",
      "description": "Device token for Apple Push Notification Service"
    },
    "oauthTokens": {
      "type": "object",
      "description": "OAuth token credentials",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "OAUTH2_TOKENS"
          ],
          "description": "Native OAuth token secret discriminator."
        },
        "accessToken": {
          "type": "string"
        },
        "refreshToken": {
          "type": "string"
        },
        "expiresIn": {
          "type": "integer"
        },
        "scopes": {
          "type": "string",
          "description": "Granted provider scopes, preserved with the OAuth credentials."
        },
        "customMetadata": {
          "type": "object",
          "additionalProperties": true,
          "description": "Opaque provider-owned credential metadata, such as the Tuya endpoint and account identifiers."
        }
      }
    },
    "usernamePassword": {
      "type": "object",
      "description": "Username and password credentials",
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "apiKey": {
      "type": "string",
      "description": "API key for service authentication (e.g. OpenRouter)"
    },
    "endpointUrl": {
      "type": "string",
      "format": "uri",
      "description": "Optional custom endpoint URL stored with an API-key connection for an OpenAI-compatible provider."
    }
  }
}
