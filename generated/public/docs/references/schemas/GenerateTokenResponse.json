{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "access_token",
    "token_type",
    "expires_in"
  ],
  "properties": {
    "access_token": {
      "type": "string",
      "description": "The access token"
    },
    "token_type": {
      "type": "string",
      "description": "The token type"
    },
    "expires_in": {
      "type": "integer",
      "description": "The token expiration time in seconds"
    },
    "refresh_token": {
      "type": "string",
      "description": "Rotating refresh credential for resource-bound grants; store privately."
    },
    "scope": {
      "type": "string",
      "description": "Granted space-separated scopes."
    }
  }
}
