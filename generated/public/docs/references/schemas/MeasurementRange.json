{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Range of measurement values (min and max)",
  "properties": {
    "min": {
      "type": "number",
      "description": "Minimum measured value"
    },
    "max": {
      "type": "number",
      "description": "Maximum measured value"
    }
  },
  "required": [
    "min",
    "max"
  ],
  "additionalProperties": false
}
