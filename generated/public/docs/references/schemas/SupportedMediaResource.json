{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SupportedMediaResource",
  "description": "A provider, media type and resource-kind combination accepted by a control route.",
  "type": "object",
  "properties": {
    "provider": {
      "$ref": "/docs/references/schemas/MediaProvider.json"
    },
    "mediaType": {
      "type": "string",
      "enum": [
        "AUDIO",
        "VIDEO",
        "IMAGE"
      ]
    },
    "resourceKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "description": "Lowercase resource-kind segment from the provider URI."
      }
    }
  },
  "required": [
    "provider",
    "mediaType",
    "resourceKinds"
  ],
  "additionalProperties": false
}
