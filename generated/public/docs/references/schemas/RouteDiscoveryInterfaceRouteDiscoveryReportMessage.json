{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-namespace": "port1/systems/zero/capability-interfaces/route-discovery",
  "x-name": "route-discovery-report",
  "x-version": "1.0",
  "x-type": "message",
  "x-directionality": "out",
  "description": "Provider report of discovered routes, group routes and their relationships. Plugin and auth-link identity come from the authenticated publisher context.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pluginIdentity": {
      "$ref": "/docs/references/schemas/ClientIdentity.json"
    },
    "authLinkIdentity": {
      "type": "string",
      "description": "The ID of the auth link the routes were discovered for."
    },
    "routes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "/docs/references/schemas/ProviderDiscoveredRoute.json"
      }
    },
    "groupRoutes": {
      "type": "array",
      "items": {
        "$ref": "/docs/references/schemas/GroupRoute.json"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "/docs/references/schemas/PluginDiscoveryRelationship.json"
      }
    }
  }
}
