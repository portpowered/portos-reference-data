{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RtspSessionInterfaceStartSessionResponseMessage",
  "x-namespace": "port1/systems/zero/capability-interfaces/rtsp-session",
  "x-name": "start-session-response",
  "x-version": "1.0",
  "x-type": "message",
  "x-directionality": "out",
  "description": "Start session response.",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "description": "Session identifier."
    },
    "uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^rtsps?://",
      "description": "RTSP stream URI.",
      "example": "rtsp://camera.example/live"
    },
    "sdp": {
      "type": "string",
      "minLength": 1,
      "description": "Optional SDP describing the stream."
    }
  },
  "required": [
    "sessionId",
    "uri"
  ],
  "additionalProperties": false
}
