{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "A cloud storage item (file or folder)",
  "properties": {
    "itemId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "Item type: FILE, FOLDER, or APP_LIBRARY"
    },
    "size": {
      "type": "integer",
      "format": "int64",
      "description": "File size in bytes"
    },
    "extension": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type"
  ]
}
