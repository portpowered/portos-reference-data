{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Interval between notifications",
  "properties": {
    "value": {
      "type": "integer",
      "description": "Interval value",
      "minimum": 1
    },
    "unit": {
      "type": "string",
      "description": "Interval unit",
      "enum": [
        "SECONDS",
        "MINUTES",
        "HOURS",
        "DAYS",
        "WEEKS",
        "MONTHS"
      ],
      "x-enum-varnames": [
        "Seconds",
        "Minutes",
        "Hours",
        "Days",
        "Weeks",
        "Months"
      ]
    }
  },
  "required": [
    "value",
    "unit"
  ],
  "additionalProperties": false
}
