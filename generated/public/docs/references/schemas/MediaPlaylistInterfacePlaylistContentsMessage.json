{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-namespace": "port1/systems/zero/capability-interfaces/media-playlist",
  "x-name": "playlist-contents",
  "x-version": "1.0",
  "x-type": "message",
  "x-directionality": "out",
  "description": "A bounded playlist page containing playable tracks or episodes.",
  "type": "object",
  "properties": {
    "playlistId": {
      "$ref": "/docs/references/schemas/MediaId.json"
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "/docs/references/schemas/Track.json"
      }
    },
    "episodes": {
      "type": "array",
      "items": {
        "$ref": "/docs/references/schemas/PodcastEpisode.json"
      }
    },
    "nextToken": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "playlistId",
    "tracks",
    "episodes"
  ],
  "additionalProperties": false
