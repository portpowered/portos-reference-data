{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Provider credentials returned by a plugin auth handler to its host.",
  "additionalProperties": false,
  "required": [
    "access_token",
    "token_type",
    "expires_in"
  ],
  "properties": {
    "access_token": {
      "type": "string"
    },
    "token_type": {
      "type": "string"
    },
    "expires_in": {
      "type": "integer",
      "description": "Seconds until the access token expires."
    },
    "customMetadata": {
      "type": "object",
      "additionalProperties": true,
      "x-go-type-skip-optional-pointer": true,
      "description": "Opaque plugin-owned metadata persisted alongside the credentials."
    },
    "refresh_token": {
      "type": "string",
      "x-go-type-skip-optional-pointer": true
    }
  }
}
