  "x-namespace": "port1/systems/zero/capability-interfaces/content-launcher",
  "x-name": "content-launcher",
  "x-version": "1.0",
  "x-type": "configuration",
  "type": "object",
  "properties": {
    "acceptHeader": {
      "type": "string",
