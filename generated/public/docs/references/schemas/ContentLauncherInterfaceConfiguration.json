    "supportedStreamingProtocols": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "DASH",
          "HLS",
          "SMOOTH_STREAMING",
          "OTHER"
        ]
      },
      "description": "Supported streaming protocols"
    }
  },
  "additionalProperties": false
}
