{
  "description": "Cleaning types, suction levels and water flows the robot supports, refreshed on every discovery. set-cleaning-mode values outside these lists are rejected before dispatch.",
  "type": "object",
  "required": [
    "supportedModes"
  ],
  "properties": {
    "supportedModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "description": "What a cleaning robot does: vacuum only, mop only, or vacuum and mop together",
        "enum": [
          "VACUUM",
          "MOP",
          "VACUUM_AND_MOP"
        ]
      },
      "description": "Supported cleaning types"
    },
    "supportedSuctionLevels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "description": "Vacuum suction level, ordered from off to strongest",
        "enum": [
          "OFF",
          "QUIET",
          "BALANCED",
          "TURBO",
          "MAX",
          "MAX_PLUS"
        ]
      },
      "description": "Supported suction levels"
    },
    "supportedWaterFlows": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "description": "Mop water flow level, ordered from off to highest",
        "enum": [
          "OFF",
          "LOW",
          "MEDIUM",
          "HIGH",
          "EXTREME"
        ]
      },
      "description": "Supported water flows"
    }
  },
  "additionalProperties": false
}
