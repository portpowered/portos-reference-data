{
  "type": "object",
  "properties": {
    "flowId": {
      "type": "string",
      "description": "Unique identifier for the flow to pause",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "description": "Reason for pausing",
      "enum": [
        "USER_REQUEST",
        "RESOURCE_LIMIT",
        "WAITING",
        "MAINTENANCE"
      ]
    },
    "checkpoint": {
      "type": "boolean",
      "description": "Whether to create a checkpoint before pausing",
      "default": true
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata for the pause operation",
      "additionalProperties": true
    }
  },
  "required": [
    "flowId",
    "reason"
  ],
  "additionalProperties": false
}
