{
  "type": "object",
  "properties": {
    "maxFlowIdLength": {
      "type": "integer",
      "description": "Maximum length for flow IDs",
      "default": 100
    },
    "maxNodeIdLength": {
      "type": "integer",
      "description": "Maximum length for node IDs",
      "default": 100
    },
    "supportedStatuses": {
      "type": "object",
      "description": "Supported flow status categories",
      "properties": {
        "flow": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "success",
              "failure",
              "cancelled",
              "timeout"
            ]
          },
          "description": "Supported flow statuses"
        },
        "node": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "success",
              "failure",
              "skipped",
              "timeout"
            ]
          },
          "description": "Supported node statuses"
        },
        "ack": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "received",
              "processed",
              "failed"
            ]
          },
          "description": "Supported acknowledgment statuses"
        }
      },
      "required": [
        "flow",
        "node",
        "ack"
      ],
      "additionalProperties": false,
      "title": "FlowSupportedStatuses"
    },
    "supportedReasons": {
      "type": "object",
      "description": "Supported flow reason categories",
      "properties": {
        "termination": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "user_request",
              "error",
              "timeout",
              "completion",
              "cancellation"
            ]
          },
          "description": "Supported termination reasons"
        },
        "pause": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "user_request",
              "resource_limit",
              "waiting",
              "maintenance"
            ]
          },
          "description": "Supported pause reasons"
        },
        "unack": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "timeout",
              "error",
              "rejected",
              "duplicate"
            ]
          },
          "description": "Supported unacknowledgment reasons"
        }
      },
      "required": [
        "termination",
        "pause",
        "unack"
      ],
      "additionalProperties": false,
      "title": "FlowSupportedReasons"
    },
    "supportedPriorities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "low",
          "normal",
          "high",
          "urgent"
        ]
      },
      "description": "Supported flow priorities"
    },
    "defaultTimeout": {
      "type": "integer",
      "description": "Default flow timeout in milliseconds",
      "default": 300000
    },
    "maxTimeout": {
      "type": "integer",
      "description": "Maximum flow timeout in milliseconds",
      "default": 86400000
    },
    "checkpointEnabled": {
      "type": "boolean",
      "description": "Whether checkpoints are enabled",
      "default": true
    }
  },
  "required": [
    "maxFlowIdLength",
    "maxNodeIdLength",
    "supportedStatuses",
    "supportedReasons",
    "supportedPriorities",
    "defaultTimeout",
    "maxTimeout",
    "checkpointEnabled"
  ],
  "additionalProperties": false,
  "description": "Flows run automations that can be initiated, paused, resumed, or terminated. Follow completion and acknowledgement events to understand the progress of a run."
}
