{
  "type": "object",
  "properties": {
    "streamId": {
      "type": "string",
      "description": "Unique identifier for this audio stream",
      "minLength": 1
    },
    "sequenceId": {
      "type": "integer",
      "description": "Sequence ID for this audio stream",
      "minimum": 0
    },
    "isFinal": {
      "type": "boolean",
      "description": "Whether this is the final chunk in the stream",
      "default": false
    },
    "audioData": {
      "type": "string",
      "description": "Base64 encoded audio data",
      "format": "base64"
    },
    "rawBytes": {
      "type": "string",
      "description": "Audio raw bytes",
      "format": "binary"
    }
  },
  "required": [
    "streamId",
    "sequenceId",
    "isFinal"
  ],
  "additionalProperties": false
}
