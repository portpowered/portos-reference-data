{
  "description": "Media players select media by its Port OS media ID, play supplied audio or a URI, and control playback. Read playback state and use only the commands supported by the connected player.",
  "type": "object",
  "properties": {
    "supportedPlaybackStates": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "The current playback state",
        "enum": [
          "playing",
          "paused",
          "stopped",
          "loading",
          "error"
        ]
      },
      "description": "Supported playback states"
    },
    "supportedPlaybackSpeeds": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Supported playback speeds (e.g., 0.5, 1.0, 1.5, 2.0)"
    },
    "seekRange": {
      "description": "Seek range in seconds",
      "type": "object",
      "properties": {
        "min": {
          "type": "number",
          "description": "Minimum measured value"
        },
        "max": {
          "type": "number",
          "description": "Maximum measured value"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false,
      "title": "MeasurementRange"
    },
    "supportedMediaTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "audio",
          "video",
          "image",
          "playlist"
        ]
      },
      "description": "List of supported media types"
    },
    "supportedFormats": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "mp3",
          "wav",
          "flac",
          "aac",
          "ogg",
          "mp4",
          "avi",
          "mkv",
          "jpg",
          "png",
          "gif"
        ]
      },
      "description": "List of supported media formats"
    },
    "maxPlaylistSize": {
      "type": "integer",
      "description": "Maximum number of items in a playlist",
      "minimum": 1,
      "maximum": 10000
    },
    "defaultQuality": {
      "type": "string",
      "description": "Default quality setting for media playback",
      "enum": [
        "low",
        "medium",
        "high",
        "lossless"
      ]
    },
    "supportsPlayURI": {
      "type": "boolean",
      "description": "Whether the endpoint can play an audio URI."
    },
    "supportedAudioMimeTypes": {
      "type": "array",
      "description": "Audio MIME types accepted by play-audio. Advertise play-audio only when audio output is supported.",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "title": "MediaPlayerInterfaceConfiguration"
}
