{
  "description": "Response to report attributes of a control route",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "A control route item with associated plugin route and attributes",
        "properties": {
          "associatedPluginRouteId": {
            "type": "string"
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "namespace": {
                  "type": "string",
                  "description": "The namespace of the attribute"
                },
                "name": {
                  "type": "string",
                  "description": "The name of the attribute"
                },
                "version": {
                  "type": "string",
                  "description": "The version of the attribute"
                },
                "value": {
                  "type": "object",
                  "description": "The value of the attribute"
                },
                "sampledAt": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Actual observation time in UTC; omit when unknown. Request time is not a sample time."
                }
              },
              "required": [
                "namespace",
                "name",
                "version",
                "value"
              ],
              "title": "AttributeSchema"
            }
          },
          "unavailableAttributes": {
            "type": "array",
            "description": "Exact attributes freshly found unavailable by a successful correlated native-group report-attributes read. Presence, including an empty list, is unsupported for endpoint, capability-query, proactive or uncorrelated reports. These identities carry no value or sample time; omission is not an unavailable acknowledgement. Upgrade consuming hosts before providers emit this field.",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "description": "The exact identity of an attribute requested from a provider, without an observed value.",
              "properties": {
                "namespace": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "namespace",
                "name",
                "version"
              ],
              "additionalProperties": false,
              "title": "AttributeSelection"
            }
          }
        },
        "required": [
          "associatedPluginRouteId",
          "attributes"
        ],
        "title": "ControlRouteItem"
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
